    {
      "id": "arch-0024",
      "type": "text",
      "x": 249.13702392578125,
      "y": 517.5,
      "width": 531.7259521484375,
      "height": 195,
      "angle": 0,
      "strokeColor": "#526578",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [
