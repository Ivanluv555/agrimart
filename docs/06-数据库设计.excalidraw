    {
      "id": "06-0102",
      "type": "text",
      "x": 115,
      "y": 1951.5,
      "width": 535.71,
      "height": 105,
      "angle": 0,
      "strokeColor": "#17324d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [
        "06-数据库设计-g22"
